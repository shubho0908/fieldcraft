{
  "name": "fieldcraft-extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:safari": "EXTENSION_TARGET=safari vite",
    "build": "tsc --noEmit && vite build",
    "build:safari": "tsc --noEmit && EXTENSION_TARGET=safari vite build && node scripts/strip-safari-sidepanel.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "vitest run src/lib/eval/eval.test.ts",
    "eval:live": "vitest run src/lib/eval/live.eval.test.ts",
    "check": "tsc --noEmit --pretty false",
    "doctor": "react-doctor . --verbose"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.17",
    "@ai-sdk/google": "^4.0.17",
    "@ai-sdk/openai": "^4.0.11",
    "ai": "^7.0.18",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@types/chrome": "^0.0.287",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
