# Optional remote URL for the extension ZIP.
# If set, /api/extension/download proxies this URL.
# If omitted, the route serves a local zip built from apps/extension during the web build.
# Use a stable HTTPS object URL in S3, Cloudflare R2, or another storage provider.
# Replace the object at the same path for each release so the landing page always serves the latest build.
EXTENSION_DOWNLOAD_URL=https://downloads.example.com/fieldcraft/latest.zip
