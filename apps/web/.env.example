# GitHub personal access token with `repo` scope, used to fetch releases from the private repository.
GITHUB_TOKEN=

# Repository to fetch releases from. Defaults to shubho0908/fieldcraft.
GITHUB_REPO=shubho0908/fieldcraft

# Exact name of the extension asset to download. Defaults to fieldcraft-extension-latest.zip.
EXTENSION_ASSET_NAME=fieldcraft-extension-latest.zip

# Cache-Control max-age for the download response, in seconds. Defaults to 60.
EXTENSION_DOWNLOAD_CACHE_SECONDS=60
