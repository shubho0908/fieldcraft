{
  "name": "fieldcraft",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run check",
    "dev": "turbo run dev",
    "doctor": "react-doctor . --verbose",
    "extension:build": "bun run --filter fieldcraft-extension build",
    "extension:dev": "bun run --filter fieldcraft-extension dev",
    "test": "turbo run test"
  },
  "devDependencies": {
    "react-doctor": "latest",
    "turbo": "latest"
  }
}
